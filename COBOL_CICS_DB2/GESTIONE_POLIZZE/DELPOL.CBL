IDENTIFICATION DIVISION.
PROGRAM-ID. DELPOL.

WORKING-STORAGE SECTION.

01 WS-COD-POL       PIC X(10).
01 WS-NOME          PIC X(40).
01 WS-SCADENZA      PIC X(10).
01 WS-IMPORTO       PIC S9(7)V99 COMP-3.

EXEC SQL
 INCLUDE SQLCA
END-EXEC.

PROCEDURE DIVISION.

MAIN-PARA.

  EXEC SQL

   DELETE
     FROM POLIZZE

    WHERE COD_POLIZZA =
          :COD-POLIZZA

END-EXEC.
       IF SQLCODE = 0

          EXEC CICS WRITEQ TD
               QUEUE('AVVISI')
               FROM(WS-COD-POL)
          END-EXEC

       END-IF

    END-PERFORM

    EXEC SQL CLOSE CAVV END-EXEC

    EXEC CICS RETURN
    END-EXEC.
